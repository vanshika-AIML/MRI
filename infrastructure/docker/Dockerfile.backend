FROM python:3.14-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app:/app/backend
WORKDIR /app
COPY backend/requirements.lock backend/requirements.lock
RUN pip install --no-cache-dir -r backend/requirements.lock
ARG INSTALL_RESEARCH_MODEL=false
COPY ml/training/requirements.txt /tmp/mri-training-requirements.txt
RUN if [ "$INSTALL_RESEARCH_MODEL" = "true" ]; then \
    pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
      --extra-index-url https://pypi.org/simple torch==2.14.1 && \
    pip install --no-cache-dir -r /tmp/mri-training-requirements.txt; \
    fi
COPY backend /app/backend
COPY ml /app/ml
RUN useradd --create-home appuser
USER appuser
WORKDIR /app/backend
HEALTHCHECK --interval=15s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/ready', timeout=3)"
CMD ["sh", "-c", "python -m alembic upgrade head && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000"]
