# ==============================================================================
# ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env before starting services locally.
# DO NOT COMMIT SENSITIVE VALUES OR PRODUCTION CREDENTIALS.
# ==============================================================================

# Backend Application Settings
APP_NAME="MRI Analysis API"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Frontend Web
VITE_API_BASE_URL=http://127.0.0.1:8000

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://mri_user:your_secure_password_here@127.0.0.1:55433/mri_db
POSTGRES_SERVER=localhost
POSTGRES_PORT=55433
POSTGRES_DB=mri_db
POSTGRES_USER=mri_user
POSTGRES_PASSWORD=your_secure_password_here
EMBEDDING_DIMENSION=768

# Redis Cache & Queue
REDIS_HOST=localhost
REDIS_PORT=6379

# Machine Learning & Storage Paths
ML_MODEL_DIR=ml/models
ML_DATASET_DIR=ml/datasets
MAX_UPLOAD_SIZE_MB=100

# Generate a persistent secret before deploying (never commit its value).
SECRET_KEY=
RATE_LIMIT_ENABLED=true
