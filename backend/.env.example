# ==============================================================================
# BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to backend/.env for local backend overrides.
# DO NOT COMMIT SENSITIVE VALUES OR PRODUCTION CREDENTIALS.
# ==============================================================================

# Application Settings
APP_NAME="MRI Analysis API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
API_PREFIX="/api/v1"

# Server Host & Port
HOST="127.0.0.1"
PORT=8000

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# Database: PostgreSQL + pgvector (Phase 3).
# Uses psycopg 3; the PostgreSQL server must have pgvector installed.
DATABASE_URL="postgresql+psycopg://mri_user:your_secure_password_here@localhost:5432/mri_db"

# Vector embedding dimension (must match the embedding model used later)
EMBEDDING_DIMENSION=768
